CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/db_clean_feed
PORT=4000

# Generate separate random values for each secret before using authentication.
SECRET=
REFRESH_SECRET=
CRYPTO_KEY=

# Optional: configure only if email verification and login alerts should send mail.
EMAIL=
PASSWORD=
EMAIL_SERVICE=

# Optional: external moderation providers are not required for local development.
PERSPECTIVE_API_KEY=
TEXTRAZOR_API_KEY=
INTERFACE_API_KEY=
PERSPECTIVE_API_DISCOVERY_URL=https://commentanalyzer.googleapis.com/$discovery/rest?version=v1alpha1
TEXTRAZOR_API_URL=https://api.textrazor.com/
INTERFACE_API_URL=https://api-inference.huggingface.co/models/facebook/bart-large-mnli

# Optional: run classifier_server locally to use the local classifier instead.
CLASSIFIER_API_URL=http://127.0.0.1:5000/classify
